{
  "name": "infection-monkey",
  "version": "2.3.0",
  "description": "Infection Monkey - Open-Source Adversary Emulation Platform",
  "author": "Infection Monkey Team",
  "license": "GPL-3.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "node server-dev.js",
    "dev:electron": "concurrently \"npx next dev -p 3000\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "prod": "cross-env SSL_CERT_PATH=../server.crt SSL_KEY_PATH=../server.key NEXT_PUBLIC_JAVASCRIPT_RUNTIME_PORT=8443 node server-prod.js",
    "build": "node build-standalone.js",
    "build:next": "next build",
    "build:electron": "npm run build:next && electron-builder --win --publish never",
    "build:electron:linux": "npm run build:next && electron-builder --linux --publish never",
    "build:electron:all": "npm run build:next && electron-builder --win --linux --publish never",
    "lint": "next lint",
    "test": "jest",
    "prod:e2e": "npm run build && npm run prod",
    "e2e": "cross-env START_SERVER_AND_TEST_INSECURE=1 start-server-and-test prod:e2e https://localhost:8443 cypress:run_e2e",
    "component": "cypress run --component",
    "cypress:open": "cross-env DEBUG=cypress:webpack cypress open",
    "cypress:run_e2e": "cypress run --e2e",
    "postinstall": "electron-builder install-app-deps || true"
  },
  "build": {
    "appId": "com.infectionmonkey.app",
    "productName": "Infection Monkey",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "node_modules/**/*",
      "public/**/*",
      "package.json",
      "next.config.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "electron/icon.ico",
      "artifactName": "InfectionMonkey-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "installerHeaderIcon": "electron/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Infection Monkey"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Security",
      "icon": "electron/icon.ico",
      "artifactName": "InfectionMonkey-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "out",
        "to": "out",
        "filter": ["**/*"]
      }
    ],
    "asar": false
  },
  "dependencies": {
    "@mui/icons-material": "^5.14.18",
    "@mui/material": "^5.14.18",
    "@mui/x-data-grid": "^6.19.6",
    "@reduxjs/toolkit": "^1.9.7",
    "@squarecloud/http-proxy": "^0.1.7",
    "@tsparticles/engine": "^3.2.1",
    "@tsparticles/preset-links": "^3.0.2",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.2.1",
    "@types/node": "^20.9.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "dotenv": "^16.3.1",
    "eslint-config-next": "^14.0.2",
    "http-proxy-middleware": "^2.0.6",
    "lodash": "^4.17.21",
    "nanoid": "^5.0.3",
    "next": "^14.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-redux": "^8.1.3",
    "sass": "^1.69.5",
    "typescript": "^5.2.2"
  },
  "devDependencies": {
    "@swc/core": "^1.3.104",
    "@swc/jest": "^0.2.29",
    "@types/jest": "^29.5.11",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "cypress": "^13.6.3",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^8.53.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "http-proxy": "^1.18.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.1.0",
    "redux-logger": "^3.0.6",
    "start-server-and-test": "^2.0.3",
    "ts-node": "^10.9.2",
    "wait-on": "^9.0.10"
  }
}
